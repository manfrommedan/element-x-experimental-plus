<resources>
    <!-- Labs toggle: phone-style 1:1 voice call layout. -->
    <string name="screen_labs_enable_phone_voice_layout">"Phone-style voice calls"</string>
    <string name="screen_labs_enable_phone_voice_layout_description">"Use a classic phone-style layout for 1:1 voice calls."</string>
    <!-- Labs toggle: bulk image/video picker in the composer. -->
    <string name="screen_labs_enable_bulk_attachments_picker">"Bulk image / video picker"</string>
    <string name="screen_labs_enable_bulk_attachments_picker_description">"Attach up to 30 photos or videos in one go, like WhatsApp and Telegram. Caption attaches to the first message; the rest are sent in selection order."</string>
    <!-- Labs toggle: copy Matrix ID shortcut in settings header. -->
    <string name="screen_labs_enable_share_mxid_shortcut">"Copy Matrix ID from settings"</string>
    <string name="screen_labs_enable_share_mxid_shortcut_description">"Adds a copy button next to your Matrix ID in the settings header so you can share it in one tap."</string>
    <!-- Labs toggle: multi-select messages with bulk actions. -->
    <string name="screen_labs_enable_message_multi_select">"Multi-select messages"</string>
    <string name="screen_labs_enable_message_multi_select_description">"Long-press a text message to start selecting, then drag up or down to sweep a whole range (the list auto-scrolls at the edges). Long-press media for its menu, where \"Select\" also starts selection. Bulk copy, forward and delete up to 30 at once."</string>
    <!-- Labs toggle: favourites pinned at the top of the chat list. -->
    <string name="screen_labs_enable_favorites_pinned_to_top">"Favourites at the top"</string>
    <string name="screen_labs_enable_favorites_pinned_to_top_description">"Show your favourite rooms in their own section above the rest of the chat list, like SchildiChat or Telegram pinned chats."</string>
    <!-- Labs toggle: phone-style incoming call screen. -->
    <string name="screen_labs_enable_phone_incoming_call">"Phone-style incoming calls"</string>
    <string name="screen_labs_enable_phone_incoming_call_description">"Show a full-screen ringing call with ringtone, answerable over the lock screen, when a call comes in - instead of a quiet heads-up notification. Voice and video calls are labelled distinctly."</string>
    <!-- Labs toggle: join an ongoing call from the chat list. -->
    <string name="screen_labs_enable_room_list_call_shortcut">"Join calls from the chat list"</string>
    <string name="screen_labs_enable_room_list_call_shortcut_description">"Tap the call icon on a room in the chat list to join its ongoing call right away, like WhatsApp or Telegram."</string>
    <!-- Labs toggle: answer an incoming call from the lock screen without unlocking. -->
    <string name="screen_labs_enable_answer_call_on_lock_screen">"Answer calls without unlocking"</string>
    <string name="screen_labs_enable_answer_call_on_lock_screen_description">"Answer an incoming call straight from the lock screen, without unlocking the device first, like WhatsApp. You still need to unlock to leave the call for the rest of the app."</string>
    <!-- Advanced settings toggle: collapse runs of redacted (deleted) events in timelines. -->
    <string name="screen_advanced_settings_hide_redacted_events_toggle_title">"Collapse deleted messages"</string>
    <string name="screen_advanced_settings_hide_redacted_events_toggle_subtitle">"Three or more deleted messages in a row are collapsed into one item. Tap to expand."</string>
    <!-- Advanced settings toggle: do not auto-download thumbnails/previews on mobile data; user taps to load each one. -->
    <string name="screen_advanced_settings_media_wifi_only_title">"Auto-download media on Wi-Fi only"</string>
    <string name="screen_advanced_settings_media_wifi_only_subtitle">"On mobile data, image/video thumbnails and map previews aren't fetched automatically. Tap each one to download it."</string>
    <!-- Advanced settings field: user-supplied Geoapify API key for the Location attachment. -->
    <string name="screen_advanced_settings_geoapify_api_key_title">"Geoapify API key (Location)"</string>
    <string name="screen_advanced_settings_geoapify_api_key_description">"Paste a free Geoapify API key (geoapify.com, 3000 requests/day) to enable the Location attachment and render maps in chat. The key is stored locally on this device and overrides the bundled one. Leave empty to use the bundled key."</string>
    <string name="screen_advanced_settings_geoapify_api_key_set">"Personal API key in use. Location attachment is enabled."</string>
