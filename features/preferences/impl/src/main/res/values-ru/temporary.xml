    <!-- Заголовки разделов Labs. -->
    <string name="screen_labs_section_make_element_better">"Как ElementX, но лучше"</string>
    <string name="screen_labs_section_calls">"Звонки"</string>
    <string name="screen_labs_section_upstream">"Element Labs"</string>
    <!-- Labs-тумблер: голосовой звонок один на один в стиле телефона. -->
    <string name="screen_labs_enable_phone_voice_layout">"Классический стиль голосовых звонков"</string>
    <string name="screen_labs_enable_phone_voice_layout_description">"Телефонный стиль для голосовых звонков 1:1."</string>
    <!-- Labs-тумблер: отправлять батч вложений по сообщению на файл. -->
    <string name="screen_labs_enable_send_media_as_separate_messages">"Сообщение на каждую картинку"</string>
    <string name="screen_labs_enable_send_media_as_separate_messages_description">"Пачка картинок уходит по сообщению на картинку: так её видит любой клиент, и каждую можно удалить или переслать отдельно. Выключи это и включи «Send gallery messages» в режиме разработчика, чтобы пачка ушла одним коллажем: у нас красивее, но клиент без поддержки MSC4274, включая element-web, покажет текст вместо картинок."</string>
    <!-- Labs-тумблер: кнопка копирования Matrix ID в шапке настроек. -->
    <string name="screen_labs_enable_share_mxid_shortcut">"Копировать Matrix ID из настроек"</string>
    <string name="screen_labs_enable_share_mxid_shortcut_description">"Кнопка копирования рядом с твоим Matrix ID в шапке настроек, поделиться в одно касание."</string>
    <!-- Labs-тумблер: выбор нескольких сообщений и групповые действия. -->
    <string name="screen_labs_enable_message_multi_select">"Множественный выбор сообщений"</string>
    <string name="screen_labs_enable_message_multi_select_description">"Долгое нажатие на текстовое сообщение начинает выбор, потяните вверх или вниз, чтобы выделить целый диапазон (у краёв список прокручивается сам). Долгое нажатие на медиа открывает меню, где «Выбрать» тоже запускает выбор. Массовое копирование, пересылка и удаление до 30 за раз."</string>
    <!-- Labs-тумблер: избранные комнаты закреплены наверху списка чатов. -->
    <string name="screen_labs_enable_favorites_pinned_to_top">"Избранные чаты наверху"</string>
    <string name="screen_labs_enable_favorites_pinned_to_top_description">"Избранные чаты показываются отдельным разделом над остальным списком, как в SchildiChat или закреплённых чатах Telegram."</string>
    <!-- Labs-тумблер: экран входящего звонка в стиле телефона. -->
    <string name="screen_labs_enable_phone_incoming_call">"Входящие звонки как на телефоне"</string>
    <string name="screen_labs_enable_phone_incoming_call_description">"Показывать полноэкранный входящий звонок с рингтоном, на который можно ответить с экрана блокировки, вместо тихого уведомления. Аудио- и видеозвонки помечаются по-разному."</string>
    <!-- Labs-тумблер: присоединиться к звонку прямо из списка чатов. -->
    <string name="screen_labs_enable_room_list_call_shortcut">"Звонок из списка чатов"</string>
    <string name="screen_labs_enable_room_list_call_shortcut_description">"Нажми на иконку звонка у чата в списке, чтобы сразу присоединиться к идущему звонку, как в WhatsApp или Telegram."</string>
    <!-- Labs-тумблер: ответ на входящий с экрана блокировки без разблокировки. -->
    <string name="screen_labs_enable_answer_call_on_lock_screen">"Ответ без разблокировки"</string>
    <string name="screen_labs_enable_answer_call_on_lock_screen_description">"Отвечать на входящий звонок прямо с экрана блокировки, не разблокируя телефон, как в WhatsApp. Разблокировка нужна только чтобы выйти из звонка в остальное приложение."</string>

